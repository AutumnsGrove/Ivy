# Secrets and local state: never commit
.env
.env.*
!.env.example
.dev/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Build and tooling output
/bin/
/bench/
# Container deployment state (bind mounts; see docker-compose.yml)
/data/
/update-signal/
node_modules/
web/.svelte-kit/
test-results/
playwright-report/
coverage/
.DS_Store

# Built frontend embedded by the Go binary: only the placeholder is committed
/internal/webui/build/*
!/internal/webui/build/.gitkeep

# Screenshots from e2e/screens.spec.ts
web/shots/
